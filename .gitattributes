# Force LF line endings for all source files
* text=auto eol=lf

# Explicitly LF
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.env*  text eol=lf
*.sh    text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore    text eol=lf

# Binary — no conversion
*.png   binary
*.jpg   binary
*.pdf   binary
*.docx  binary
