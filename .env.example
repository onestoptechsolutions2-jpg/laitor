# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Evolution API (WhatsApp) ─────────────────────────────
EVOLUTION_API_URL=https://your-evolution-api.com
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=laitor          # Evolution instance name

# ─── Twenty CRM ───────────────────────────────────────────
CRM_URL=https://your-twenty-crm.com
CRM_API_KEY=your_twenty_crm_api_key

# ─── Manager.io ───────────────────────────────────────────
MANAGER_URL=https://finance360.laitor.co.ke/api2   # MUST be HTTPS, include /api2
MANAGER_API_KEY=your_manager_io_api_token          # Settings → API; sent as X-API-KEY header
                                                    # Business is resolved server-side — no business key needed

# ─── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://laitor:password@postgres:5432/laitor

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Webhook Security ─────────────────────────────────────
WEBHOOK_SECRET=your_webhook_secret_token

# ─── Session ──────────────────────────────────────────────
SESSION_TTL_SECONDS=3600           # 1 hour conversation window

# ─── Admin Notifications ──────────────────────────────────
ADMIN_PHONES=2547XXXXXXXX,2547YYYYYYYY   # comma-separated admin WhatsApp numbers
